# Puertos expuestos al host (verificados libres durante la inspeccion del entorno)
NGINX_PORT=8097
WEBSOCKET_PORT=8098

# Synchronization Engine
SYNC_POLLING_INTERVAL_SECONDS=2

# Monitoring Engine (App\Monitoring)
MONITORING_POLLING_INTERVAL_SECONDS=10

# Daily Cutover Engine (App\Dashboard) — corte de jornada operativa a las
# 07:00 (ver App\Dashboard\BusinessDay). No necesita ser más fino que un
# minuto porque solo compara contra la hora del corte.
DAILY_CUTOVER_POLLING_INTERVAL_SECONDS=60

# Valor de guias.estatus en SICRET que representa "guía liberada" — no
# confirmado todavía, ver App\Infrastructure\Sicret\PdoSicretGateway.
SICRET_LIBERACION_ESTATUS_CONFIRMACION=

# Carpeta OUT del sistema de timbrado legacy de SICRET (donde el usuario
# genera manualmente el XML/PDF del Complemento Carta Porte, nombrados por
# el valor de factImpresa). Ruta vista DENTRO de los contenedores
# atlas-monitoring y atlas-php — ver docker-compose.yml para el mapeo al
# host/red real. SICRET_TIMBRADO_OUT_HOST_PATH es esa ruta real en el host
# (en producción, la misma carpeta que usa el cliente legacy de SICRET).
# Puente temporal, ver App\Monitoring\Timbrado\StampingEvidenceSource y
# App\Timbrado\CartaPorteRepository.
SICRET_TIMBRADO_OUT_PATH=/timbrado-out
SICRET_TIMBRADO_OUT_HOST_PATH=./storage/timbrado-out

# WebSocket server
WEBSOCKET_INTERNAL_HOST=websocket
WEBSOCKET_PUBLISH_PORT=8099

# ATLAS - base de datos propia (lectura/escritura)
ATLAS_DB_HOST=db
ATLAS_DB_PORT=3306
ATLAS_DB_EXTERNAL_PORT=3311
ATLAS_DB_DATABASE=atlas
ATLAS_DB_USERNAME=atlas
ATLAS_DB_PASSWORD=
ATLAS_DB_ROOT_PASSWORD=

# FORSIS - SICRET, solo lectura (base fisica: sicrePR)
FORSIS_DB_HOST=
FORSIS_DB_PORT=
FORSIS_DB_DATABASE=
FORSIS_DB_USERNAME=
FORSIS_DB_PASSWORD=

# FORSIS_2 - SICRET, solo lectura (base fisica: sicre2PR)
FORSIS_2_DB_HOST=
FORSIS_2_DB_PORT=
FORSIS_2_DB_DATABASE=
FORSIS_2_DB_USERNAME=
FORSIS_2_DB_PASSWORD=

# GERO - SICRET, solo lectura (base fisica: sicreGero)
GERO_DB_HOST=
GERO_DB_PORT=
GERO_DB_DATABASE=
GERO_DB_USERNAME=
GERO_DB_PASSWORD=

# GERO_2 - SICRET, solo lectura (base fisica: sicre2Gero)
GERO_2_DB_HOST=
GERO_2_DB_PORT=
GERO_2_DB_DATABASE=
GERO_2_DB_USERNAME=
GERO_2_DB_PASSWORD=

# FORSIS_DB_WRITE / GERO_DB_WRITE - SICRET, ESCRITURA, exclusivo de
# App\Infrastructure\Sicret\PdoSicretGateway. No aprovisionadas todavía.
FORSIS_DB_WRITE_HOST=
FORSIS_DB_WRITE_PORT=
FORSIS_DB_WRITE_DATABASE=
FORSIS_DB_WRITE_USERNAME=
FORSIS_DB_WRITE_PASSWORD=

GERO_DB_WRITE_HOST=
GERO_DB_WRITE_PORT=
GERO_DB_WRITE_DATABASE=
GERO_DB_WRITE_USERNAME=
GERO_DB_WRITE_PASSWORD=

# Mattermost Integration
MATTERMOST_URL=
MATTERMOST_TOKEN=
MATTERMOST_WEBHOOK=
MATTERMOST_TEAM=
MATTERMOST_CHANNEL_ANUNCIOS=anuncios
MATTERMOST_CHANNEL_TRAFICO=trafico
MATTERMOST_CHANNEL_FACTURACION=facturacion
MATTERMOST_CHANNEL_TIMBRES_FISCALES=timbres-fiscales
MATTERMOST_BOT_USERNAME=ATLAS
# FORSIS / Trafico-system — Webhook de eventos en tiempo real (Fase E.3)
# Ver App\Notifications\Consumers\Trafico\TraficoWebhookConsumer.
TRAFICO_EVENTS_URL=http://trafico-nginx:8091/api/facturacion/eventos-atlas
TRAFICO_EVENTS_SECRET=
