# Puertos expuestos al host (verificados libres durante la inspeccion del entorno)
NGINX_PORT=8097
WEBSOCKET_PORT=8098

# Synchronization Engine
SYNC_POLLING_INTERVAL_SECONDS=2

# Monitoring Engine (App\Monitoring)
MONITORING_POLLING_INTERVAL_SECONDS=10

# Valor de guias.estatus en SICRET que representa "guía liberada" — no
# confirmado todavía, ver App\Infrastructure\Sicret\PdoSicretGateway.
SICRET_LIBERACION_ESTATUS_CONFIRMACION=

# Carpeta OUT del sistema de timbrado legacy de SICRET (donde el usuario
# genera manualmente el XML/PDF). Ruta vista DENTRO del contenedor
# atlas-monitoring — ver docker-compose.yml para el mapeo al host/red real.
# Puente temporal, ver App\Monitoring\Timbrado\StampingEvidenceSource.
SICRET_TIMBRADO_OUT_PATH=/timbrado-out

# WebSocket server
WEBSOCKET_INTERNAL_HOST=websocket
WEBSOCKET_PUBLISH_PORT=8099

# ATLAS - base de datos propia (lectura/escritura)
ATLAS_DB_HOST=db
ATLAS_DB_PORT=3306
ATLAS_DB_EXTERNAL_PORT=3311
ATLAS_DB_DATABASE=atlas
ATLAS_DB_USERNAME=atlas
ATLAS_DB_PASSWORD=
ATLAS_DB_ROOT_PASSWORD=

# FORSIS - SICRET, solo lectura (base fisica: sicrePR)
FORSIS_DB_HOST=
FORSIS_DB_PORT=
FORSIS_DB_DATABASE=
FORSIS_DB_USERNAME=
FORSIS_DB_PASSWORD=

# FORSIS_2 - SICRET, solo lectura (base fisica: sicre2PR)
FORSIS_2_DB_HOST=
FORSIS_2_DB_PORT=
FORSIS_2_DB_DATABASE=
FORSIS_2_DB_USERNAME=
FORSIS_2_DB_PASSWORD=

# GERO - SICRET, solo lectura (base fisica: sicreGero)
GERO_DB_HOST=
GERO_DB_PORT=
GERO_DB_DATABASE=
GERO_DB_USERNAME=
GERO_DB_PASSWORD=

# GERO_2 - SICRET, solo lectura (base fisica: sicre2Gero)
GERO_2_DB_HOST=
GERO_2_DB_PORT=
GERO_2_DB_DATABASE=
GERO_2_DB_USERNAME=
GERO_2_DB_PASSWORD=

# FORSIS_DB_WRITE / GERO_DB_WRITE - SICRET, ESCRITURA, exclusivo de
# App\Infrastructure\Sicret\PdoSicretGateway. No aprovisionadas todavía.
FORSIS_DB_WRITE_HOST=
FORSIS_DB_WRITE_PORT=
FORSIS_DB_WRITE_DATABASE=
FORSIS_DB_WRITE_USERNAME=
FORSIS_DB_WRITE_PASSWORD=

GERO_DB_WRITE_HOST=
GERO_DB_WRITE_PORT=
GERO_DB_WRITE_DATABASE=
GERO_DB_WRITE_USERNAME=
GERO_DB_WRITE_PASSWORD=
